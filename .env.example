# GEMINI_API_KEY: Required only if Gemini AI features are enabled server-side.
# Never expose this value with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical URL where the application is hosted.
APP_URL="MY_APP_URL"

# Firebase App Check (reCAPTCHA Enterprise public site key).
# This is intentionally public and may be exposed to the browser.
# After configuring the key here/in Vercel, enable App Check enforcement
# for Firestore and Authentication in the Firebase Console.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=""
