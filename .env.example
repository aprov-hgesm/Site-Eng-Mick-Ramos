# Server-side only. Never expose secrets with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Canonical application URL for server-side features, when used.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Reusable client/site configuration
# These values are intentionally public because they are rendered in the site.
# Omit them to keep the current Mick Ramos defaults.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_THEME="mick"
NEXT_PUBLIC_CLIENT_COMPANY_NAME="MR Engenharia"
NEXT_PUBLIC_CLIENT_BRAND_NAME="MR MICK RAMOS"
NEXT_PUBLIC_CLIENT_PROFESSIONAL_NAME="Mick Ramos"
NEXT_PUBLIC_CLIENT_ROLE="Engenheiro Civil"
NEXT_PUBLIC_CLIENT_REGISTRATION="CREA 1920983666"
NEXT_PUBLIC_CLIENT_EMAIL="engcivilmickramos@gmail.com"
NEXT_PUBLIC_CLIENT_PHONE="(86) 99927-0261"
NEXT_PUBLIC_CLIENT_WHATSAPP_DISPLAY="+55 86 99927-0261"
NEXT_PUBLIC_CLIENT_WHATSAPP_URL="https://wa.me/5586999270261"

# Public UID used by the client-side admin gate. This is not the security
# boundary by itself: Firestore Rules/Firebase Authentication must authorize
# the same administrator independently.
NEXT_PUBLIC_ADMIN_UID="YOUR_FIREBASE_ADMIN_UID"

# Public metadata / SEO configuration.
NEXT_PUBLIC_SITE_URL="https://site-eng-mick-ramos.vercel.app"
NEXT_PUBLIC_SITE_TITLE="MR Engenharia | Mick Ramos - Engenheiro Civil CREA-PI | Parnaíba"
NEXT_PUBLIC_SITE_DESCRIPTION="Projetos de engenharia civil, laudos técnicos, regularização de imóveis e acompanhamento de obras."
NEXT_PUBLIC_SITE_OG_TITLE="MR Engenharia | Mick Ramos - Engenheiro Civil"
NEXT_PUBLIC_SITE_OG_DESCRIPTION="Soluções completas em engenharia civil."
NEXT_PUBLIC_SITE_PREVIEW_IMAGE="/imagem-preview.jpg"
NEXT_PUBLIC_SITE_STORAGE_NAMESPACE="mr_engenharia"

# EmailJS browser identifiers. They are public identifiers, not server secrets.
# Prefer a separate service/template per client deployment.
NEXT_PUBLIC_EMAILJS_SERVICE_ID="YOUR_EMAILJS_SERVICE_ID"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="YOUR_EMAILJS_TEMPLATE_ID"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="YOUR_EMAILJS_PUBLIC_KEY"

# Firebase App Check (reCAPTCHA Enterprise public site key).
# Keep disabled during a Firebase-project cutover. After registering a new key
# in the destination project and validating token metrics, set ENABLED to 1.
NEXT_PUBLIC_FIREBASE_APPCHECK_ENABLED="0"
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=""
