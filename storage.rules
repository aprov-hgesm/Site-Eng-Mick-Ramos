rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'hx9EpMe3uhgdaIxlhS8FcsKAhcB2';
    }

    // Default: deny everything
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Public read for site images, write only for the authorized admin
    match /site-images/{folder}/{imageName} {
      allow read: if true;
      allow write: if isAdmin() 
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
