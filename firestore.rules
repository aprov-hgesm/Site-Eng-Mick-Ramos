rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares para validação de integridade dos dados
    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    function hasAllRequiredFields(data, requiredFields) {
      return data.keys().hasAll(requiredFields);
    }

    function isValidString(data, field, maxLen) {
      return data[field] is string && data[field].size() <= maxLen;
    }

    function isNonEmptyString(data, field, maxLen) {
      return isValidString(data, field, maxLen) && data[field].size() > 0;
    }

    function isAdmin() {
      // Ambiente MR Engenharia isolado: a autorização administrativa exige
      // simultaneamente o UID e o e-mail esperados no novo projeto Firebase.
      // MFA/App Check serão reativados após a validação do cutover.
      return request.auth != null
        && request.auth.uid == '5vhxe0pmozbkIXuWfFIekTzWcYV2'
        && request.auth.token.email == 'codex.martis.dev@gmail.com';
    }

    function hasExpectedTargetEmail(data) {
      return data.targetEmail == 'engcivilmickramos@gmail.com';
    }

    // 1. Negação total como regra padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Coleções de conteúdo institucional: leitura pública, escrita para administrador
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Somente documentos de configuração explicitamente públicos podem ser lidos.
    // Isso evita que um futuro documento interno em siteConfig seja exposto por engano.
    match /siteConfig/{configId} {
      allow read: if configId == 'contact'
                  || configId == 'about'
                  || configId == 'images'
                  || configId == 'homeAboutImage';
      allow create, update, delete: if isAdmin();
    }

    // 3. Solicitações de Orçamento (quoteRequests): somente criação pública validada.
    // O enforcement do App Check é aplicado no serviço e complementa estas regras.
    match /quoteRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if hasOnlyAllowedFields(request.resource.data, [
                      'name', 'phone', 'email', 'service', 'propertyType',
                      'areaSize', 'location', 'details', 'targetEmail',
                      'createdAt', 'status'
                    ])
                    && hasAllRequiredFields(request.resource.data, [
                      'name', 'phone', 'email', 'service', 'propertyType',
                      'areaSize', 'location', 'details', 'targetEmail',
                      'createdAt', 'status'
                    ])
                    && isNonEmptyString(request.resource.data, 'name', 120)
                    && isNonEmptyString(request.resource.data, 'phone', 30)
                    && isValidString(request.resource.data, 'email', 254)
                    && isNonEmptyString(request.resource.data, 'service', 150)
                    && isNonEmptyString(request.resource.data, 'propertyType', 80)
                    && isValidString(request.resource.data, 'areaSize', 30)
                    && isNonEmptyString(request.resource.data, 'location', 150)
                    && isValidString(request.resource.data, 'details', 3000)
                    && isNonEmptyString(request.resource.data, 'targetEmail', 254)
                    && isNonEmptyString(request.resource.data, 'createdAt', 40)
                    && hasExpectedTargetEmail(request.resource.data)
                    && request.resource.data.status == 'nova';
    }

    // 4. Mensagens de Contato (contactMessages): somente criação pública validada.
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if hasOnlyAllowedFields(request.resource.data, [
                      'name', 'email', 'whatsapp', 'subject', 'message',
                      'targetEmail', 'createdAt', 'status'
                    ])
                    && hasAllRequiredFields(request.resource.data, [
                      'name', 'email', 'whatsapp', 'subject', 'message',
                      'targetEmail', 'createdAt', 'status'
                    ])
                    && isNonEmptyString(request.resource.data, 'name', 120)
                    && isNonEmptyString(request.resource.data, 'email', 254)
                    && isNonEmptyString(request.resource.data, 'whatsapp', 30)
                    && isNonEmptyString(request.resource.data, 'subject', 120)
                    && isNonEmptyString(request.resource.data, 'message', 3000)
                    && isNonEmptyString(request.resource.data, 'targetEmail', 254)
                    && isNonEmptyString(request.resource.data, 'createdAt', 40)
                    && hasExpectedTargetEmail(request.resource.data)
                    && request.resource.data.status == 'nova';
    }
  }
}
