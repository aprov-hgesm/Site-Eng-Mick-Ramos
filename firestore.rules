rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares para validação de integridade dos dados
    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    function hasAllRequiredFields(data, requiredFields) {
      return data.keys().hasAll(requiredFields);
    }

    function isValidString(data, field, maxLen) {
      return data[field] is string && data[field].size() <= maxLen;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'hx9EpMe3uhgdaIxlhS8FcsKAhcB2';
    }

    // 1. Negação total como regra padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Coleções de conteúdo institucional: leitura pública, escrita para administrador
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 3. Solicitações de Orçamento (quoteRequests): somente criação pública validada
    match /quoteRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if hasOnlyAllowedFields(request.resource.data, [
                      'name', 'phone', 'email', 'service', 'propertyType', 
                      'areaSize', 'location', 'details', 'targetEmail', 
                      'createdAt', 'status'
                    ])
                    && hasAllRequiredFields(request.resource.data, [
                      'name', 'phone', 'email', 'service', 'propertyType', 
                      'areaSize', 'location', 'details', 'targetEmail', 
                      'createdAt', 'status'
                    ])
                    && isValidString(request.resource.data, 'name', 120)
                    && isValidString(request.resource.data, 'phone', 30)
                    && isValidString(request.resource.data, 'email', 254)
                    && isValidString(request.resource.data, 'service', 150)
                    && isValidString(request.resource.data, 'propertyType', 80)
                    && isValidString(request.resource.data, 'areaSize', 30)
                    && isValidString(request.resource.data, 'location', 150)
                    && isValidString(request.resource.data, 'details', 3000)
                    && isValidString(request.resource.data, 'targetEmail', 254)
                    && isValidString(request.resource.data, 'createdAt', 40)
                    && request.resource.data.status == 'nova';
    }

    // 4. Mensagens de Contato (contactMessages): somente criação pública validada
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if hasOnlyAllowedFields(request.resource.data, [
                      'name', 'email', 'whatsapp', 'subject', 'message', 
                      'targetEmail', 'createdAt', 'status'
                    ])
                    && hasAllRequiredFields(request.resource.data, [
                      'name', 'email', 'whatsapp', 'subject', 'message', 
                      'targetEmail', 'createdAt', 'status'
                    ])
                    && isValidString(request.resource.data, 'name', 120)
                    && isValidString(request.resource.data, 'email', 254)
                    && isValidString(request.resource.data, 'whatsapp', 30)
                    && isValidString(request.resource.data, 'subject', 120)
                    && isValidString(request.resource.data, 'message', 3000)
                    && isValidString(request.resource.data, 'targetEmail', 254)
                    && isValidString(request.resource.data, 'createdAt', 40)
                    && request.resource.data.status == 'nova';
    }
  }
}

